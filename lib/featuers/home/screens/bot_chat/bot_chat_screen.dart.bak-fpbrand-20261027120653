// ─── Model ─────────────────────────────────────────────────────────────────────

class BotMessage {
  final int? messageId;
  final String content;
  final bool isBot;
  final DateTime createdAt;

  const BotMessage({
    this.messageId,
    required this.content,
    required this.isBot,
    required this.createdAt,
  });

  factory BotMessage.fromJson(Map<String, dynamic> json) => BotMessage(
    messageId: json['message_id'],
    content: json['content'] ?? '',
    isBot: json['role'] == 'assistant',
    createdAt: DateTime.tryParse(json['created_at'] ?? '') ?? DateTime.now(),
  );
}

// ─── Screen ────────────────────────────────────────────────────────────────────
// Only responsible for:
//   1. Owning TextEditingController + ScrollController (need dispose)
//   2. Calling provider.initChatSession once in initState
//   3. Wiring the scroll-pagination listener

class BotChatScreen extends StatefulWidget {
  final int chatId;
  final String chatName;
  final String groupIcon;

  const BotChatScreen({
    super.key,
    required this.chatId,
    required this.chatName,
    required this.groupIcon,
  });

  @override
  State<BotChatScreen> createState() => _BotChatScreenState();
}

class _BotChatScreenState extends State<BotChatScreen> {
  final TextEditingController _msgController = TextEditingController();
  final ScrollController _scrollController = ScrollController();

  @override
  void initState() {
    super.initState();
    _scrollController.addListener(_onScroll);

    // Init provider session after first frame so context is ready
    WidgetsBinding.instance.addPostFrameCallback((_) {
      final provider = context.read<ChatbotProvider>();
      provider.initChatSession(
        chatId: widget.chatId,
        socketEventController: context.read<SocketEventController>(),
      );
    });
  }

  @override
  void dispose() {
    _scrollController.removeListener(_onScroll);
    _scrollController.dispose();
    _msgController.dispose();
    super.dispose();
  }

  // ── Pagination trigger ────────────────────────────────────────────────────

  void _onScroll() {
    // reverse:true list → top of screen is maxScrollExtent
    if (_scrollController.position.pixels >=
        _scrollController.position.maxScrollExtent - 200) {
      context.read<ChatbotProvider>().loadMoreHistory();
    }
  }

  // ── Scroll to bottom ──────────────────────────────────────────────────────

  void _scrollToBottom() {
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (_scrollController.hasClients) {
        _scrollController.animateTo(
          0,
          duration: const Duration(milliseconds: 300),
          curve: Curves.easeOut,
        );
      }
    });
  }

  Future<void> _onSend() async {
    final provider = context.read<ChatbotProvider>();
    if (provider.limitReached) {
      snackbarNew(context, msg: "You have reached your limit.");
      return;
    }
    if (_msgController.text.trim().isEmpty) {
      return;
    }
    FocusScope.of(context).unfocus();
    FocusManager.instance.primaryFocus?.unfocus();

    final socketEventController = context.read<SocketEventController>();

    // Call refresh only when no messages exist
    if (provider.messages.isEmpty) {
      await _onRefreshHistory();
    }

    final sent = provider.sendMessage(
      text: _msgController.text,
      socketEventController: socketEventController,
    );

    if (sent) {
      _msgController.clear();
      _scrollToBottom();
    }
  }

  // ── Refresh history ───────────────────────────────────────────────────────

  Future<void> _onRefreshHistory() async {
    await context.read<ChatbotProvider>().refreshConversationHistory().then((
      _,
    ) {
      _scrollToBottom();
    });
  }

  // ── Build ─────────────────────────────────────────────────────────────────

  @override
  Widget build(BuildContext context) {
    SizeConfig().init(context);
    SystemChrome.setSystemUIOverlayStyle(
      const SystemUiOverlayStyle(
        statusBarColor: Colors.transparent,
        statusBarIconBrightness: Brightness.dark,
      ),
    );

    return GestureDetector(
      onTap: () => FocusScope.of(context).unfocus(),
      child: Scaffold(
        backgroundColor: AppThemeManage.appTheme.scaffoldBackColor,
        appBar: _BotChatAppBar(
          chatName: widget.chatName,
          groupIcon: widget.groupIcon,
          onRefreshHistory: _onRefreshHistory,
        ),
        body: Stack(
          children: [
            Column(
              children: [
                Consumer2<SocketEventController, ChatProvider>(
                  builder: (_, socketController, chatProvider, _) {
                    if (socketController.isConnected) {
                      return const SizedBox.shrink();
                    }

                    return Container(
                      width: double.infinity,
                      padding: const EdgeInsets.symmetric(
                        vertical: 6,
                        horizontal: 16,
                      ),
                      color: Colors.orange.withValues(alpha: 0.8),
                      child: Row(
                        children: [
                          SizedBox(
                            width: 14,
                            height: 14,
                            child: CircularProgressIndicator(
                              strokeWidth: 2,
                              color: Colors.white,
                            ),
                          ),
                          const SizedBox(width: 8),

                          Expanded(
                            child: Text(
                              AppString.connectingToChatService,
                              style: TextStyle(
                                color: Colors.white,
                                fontSize: 12,
                              ),
                            ),
                          ),

                          InkWell(
                            onTap: () {
                              chatProvider.connect();
                            },
                            child: const Icon(
                              Icons.refresh,
                              size: 16,
                              color: Colors.white,
                            ),
                          ),
                        ],
                      ),
                    );
                  },
                ),
                Expanded(
                  child: _MessageList(scrollController: _scrollController),
                ),
                _InputBar(msgController: _msgController, onSend: _onSend),
              ],
            ),
            // Full-screen loading overlay while fetching history
            Consumer<ChatbotProvider>(
              builder: (_, provider, _) {
                if (!provider.isChatHistoryLoad) return const SizedBox.shrink();
                return Stack(
                  children: [
                    ModalBarrier(
                      dismissible: false,
                      color: AppThemeManage.appTheme.darkWhiteColor.withValues(
                        alpha: 0.08,
                      ),
                    ),
                    Center(child: commonLoading()),
                  ],
                );
              },
            ),
          ],
        ),
      ),
    );
  }
}

