// ─── Message list ──────────────────────────────────────────────────────────────

class _MessageList extends StatelessWidget {
  final ScrollController scrollController;

  const _MessageList({required this.scrollController});

  @override
  Widget build(BuildContext context) {
    final messages = context.select<ChatbotProvider, List<BotMessage>>(
      (p) => p.messages,
    );
    final isBotTyping = context.select<ChatbotProvider, bool>(
      (p) => p.isBotTyping,
    );
    final streamingText = context.select<ChatbotProvider, String?>(
      (p) => p.streamingText,
    );
    final isPaginationLoading = context.select<ChatbotProvider, bool>(
      (p) => p.isPaginationLoading,
    );

    if (messages.isEmpty && !isBotTyping) {
      return Center(
        child: Text('Chat with AI', style: AppTypography.innerText16(context)),
      );
    }

    final itemCount =
        messages.length + (isBotTyping ? 1 : 0) + (isPaginationLoading ? 1 : 0);

    return ListView.builder(
      controller: scrollController,
      reverse: true,
      padding: SizeConfig.getPaddingSymmetric(horizontal: 16, vertical: 12),
      itemCount: itemCount,
      itemBuilder: (context, index) {
        // Pagination loader at the logical bottom (highest index in reversed list)
        if (isPaginationLoading &&
            index == messages.length + (isBotTyping ? 1 : 0)) {
          return Padding(
            padding: const EdgeInsets.symmetric(vertical: 8.0),
            child: Center(
              child: SizedBox(
                height: 19,
                width: 19,
                child: CircularProgressIndicator(
                  strokeWidth: 2,
                  valueColor: AlwaysStoppedAnimation<Color>(
                    AppColors.appPriSecColor.primaryColor,
                  ),
                ),
              ),
            ),
          );
          // Padding(
          //   padding: const EdgeInsets.symmetric(vertical: 12),
          //   child: Center(child: commonLoading()),
          // );
        }

        // Typing / streaming bubble at the top (index 0 in reversed list)
        if (isBotTyping && index == 0) {
          return _TypingBubble(streamingText: streamingText);
        }

        final messageIndex =
            messages.length - 1 - (isBotTyping ? index - 1 : index);
        return _MessageBubble(message: messages[messageIndex]);
      },
    );
  }
}

