  /// Builds the fixed demo transcript for the AI Assistant chat, oldest
  /// first, timestamped so it reads as a conversation that already happened.
  static List<chats.Records> build({
    required int chatId,
    required int myUserId,
    required int botUserId,
  }) {
    const uuid = Uuid();
    final now = DateTime.now();

    final myName =
        [global.firstName, global.lastName]
            .where((s) => s.trim().isNotEmpty)
            .join(' ')
            .trim();
    final myUser = chats.User(
      userId: myUserId,
      userName: global.userName,
      fullName: myName.isNotEmpty ? myName : global.userName,
      profilePic: global.userProfile,
    );
    final botUser = chats.User(
      userId: botUserId,
      userName: AiAssistantProvider.botUserName,
      fullName: AiAssistantProvider.botDisplayName,
    );

    chats.Records makeRecord({
      required int id,
      required int senderId,
      required chats.User user,
      required String body,
      required int minutesAgo,
    }) {
      final createdAt =
          now.subtract(Duration(minutes: minutesAgo)).toIso8601String();
      return chats.Records(
        messageId: id,
        chatId: chatId,
        senderId: senderId,
        messageType: 'text',
        messageContent: body,
        createdAt: createdAt,
        updatedAt: createdAt,
        messageSeenStatus: 'read',
        pinned: false,
        stared: false,
        deletedForEveryone: false,
        isEdited: false,
        isFollowing: true,
        user: user,
        tempId: uuid.v4(),
        sendingStatus: chats.MessageSendingStatus.sent,
      );
    }

    final records = <chats.Records>[];
    var seq = 1;
    final totalTurns = _qa.length * 2;
    for (var i = 0; i < _qa.length; i++) {
      final pair = _qa[i];
      final userMinutesAgo = (totalTurns - i * 2) * 2;
      final aiMinutesAgo = userMinutesAgo - 1;
      records.add(
        makeRecord(
          id: seq++,
          senderId: myUserId,
          user: myUser,
          body: pair.user,
          minutesAgo: userMinutesAgo,
        ),
      );
      records.add(
        makeRecord(
          id: seq++,
          senderId: botUserId,
          user: botUser,
          body: pair.ai,
          minutesAgo: aiMinutesAgo,
        ),
      );
    }
    return records;
  }
