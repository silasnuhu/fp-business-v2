  /// Redesigned chat header.
  ///
  /// Keeps the stock title builder (avatar / name / presence, search field)
  /// and the stock action set (ChatCallButtons + multi-select actions) so
  /// calling, selection and search behave exactly as before — only the chrome
  /// is new: a surface bar with a hairline, no Material elevation, and an
  /// inset back affordance that matches the rest of the redesign.
  PreferredSize _buildFpAppBar() {
    return PreferredSize(
      preferredSize: Size.fromHeight(SizeConfig.sizedBoxHeight(65)),
      child: Container(
        decoration: BoxDecoration(
          color: Fp.inkSoft.withValues(alpha: 0.97),
          border: Border(
            bottom: BorderSide(color: Fp.hairline, width: 1),
          ),
        ),
        child: SafeArea(
          bottom: false,
          child: Row(
            children: [
              if (!_isSearchMode)
                InkWell(
                  borderRadius: BorderRadius.circular(Fp.rPill),
                  onTap:
                      _isMultiSelectMode ? _exitMultiSelectMode : _navigateBack,
                  child: Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 10),
                    child: Icon(
                      Icons.arrow_back_ios_new_rounded,
                      size: 19,
                      color: Fp.text,
                    ),
                  ),
                ),
              Expanded(child: _buildAppBarTitle()),
              if (!widget.isAdminChat)
                if (_isMultiSelectMode)
                  ..._buildMultiSelectActions()
                else
                  Padding(
                    padding: const EdgeInsets.only(right: 4),
                    child: ChatCallButtons(
                      chatId: widget.chatId ?? 0,
                      chatName: widget.chatName,
                      profilePic: widget.profilePic,
                      userId: widget.userId,
                    ),
                  ),
            ],
          ),
        ),
      ),
    );
  }

