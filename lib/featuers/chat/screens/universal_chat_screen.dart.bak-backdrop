  bool? _isAiAssistantChatCache;
  bool get _isAiAssistantChat =>
      _isAiAssistantChatCache ??= _resolveIsAiAssistantChat();

  /// Whether this is the AI Assistant chat — known to AiAssistantProvider
  /// when opened from its entry point, otherwise recognised by the bot's
  /// reserved userName on the chat-list row (opened from the list or a
  /// notification).
  bool _resolveIsAiAssistantChat() {
    if (isGroupChat || widget.isAdminChat) return false;
    final aiProvider = Provider.of<AiAssistantProvider>(context, listen: false);
    if (aiProvider.isAiChat(widget.chatId) ||
        aiProvider.isBotUser(widget.userId)) {
      return true;
    }

    final chatId = widget.chatId ?? 0;
    if (chatId <= 0) return false;
    final chatList =
        Provider.of<ChatProvider>(context, listen: false).chatListData.chats;
    for (final chat in chatList) {
      if (chat.records?.firstOrNull?.chatId != chatId) continue;
      if (!AiAssistantProvider.isBotUserName(chat.peerUserData?.userName)) {
        return false;
      }
      aiProvider.rememberAiChat(chatId: chatId, botUserId: widget.userId);
      return true;
    }
    return false;
  }

