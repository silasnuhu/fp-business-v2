  // ═══════════════════════════════════════════════════════════════════════════
  // MESSAGE SENDING METHODS
  // ═══════════════════════════════════════════════════════════════════════════

  void _sendTextMessage() {
    if (_chatProvider!.isDisposedOfChat ||
        !mounted ||
        _messageController.text.trim().isEmpty) {
      return;
    }

    // ✅ DEMO MODE: the AI Assistant chat shows a fixed canned transcript
    // for demo accounts (no live provider key) — sending is read-only.
    if (isDemo && _isAiAssistantChat) {
      snackbarNew(
        context,
        msg: AppString.demoAccountsCannotSendMessagesHere,
      );
      return;
    }

    final chatProvider =
        _chatProvider ?? Provider.of<ChatProvider>(context, listen: false);
    final chatId = widget.chatId ?? 0;
    final replyToMessageId = chatProvider.replyToMessage?.messageId;
    final messageText = _messageController.text.trim();

    _logger.d(
      "Sending message to ${chatId == 0 ? 'new user' : 'existing chat'}: ${widget.userId}, replyTo: $replyToMessageId",
    );

    // ✅ Check if it's a URL - use old method for links (requires special handling)
    if (isURL(messageText)) {
      chatProvider
          .sendMessage(
            chatId: chatId,
            messageText,
            messageType: MessageType.Link,
            replyToMessageId: replyToMessageId,
          )
          .then((success) {
            // closeKeyboard();
            if (!_chatProvider!.isDisposedOfChat && mounted) {
              if (success) {
                _messageController.clear();
                _sendTypingEvent(false);
                WidgetsBinding.instance.addPostFrameCallback((_) {
                  if (!_chatProvider!.isDisposedOfChat && mounted) {
                    _scrollToBottom(animated: true, forceScroll: true);
                  }
                });
              } else {
                final apiError = chatProvider.apiErrorMessage;
                if (apiError != null && apiError.isNotEmpty) {
                  snackbarNew(context, msg: apiError);
                  chatProvider.clearApiErrorMessage();
                }
              }
            }
          });
      return;
    }

    // ✅ OPTIMISTIC UI: Instant message display for text messages
    chatProvider.sendTextMessageOptimistic(
      messageContent: messageText,
      chatId: chatId,
      userId: widget.userId,
      replyToMessageId: replyToMessageId,
    );

    // ✅ Clear input immediately (no waiting for API)
    _messageController.clear();
    _sendTypingEvent(false);
    // closeKeyboard();

    // ✅ Scroll to bottom immediately
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!_chatProvider!.isDisposedOfChat && mounted) {
        _scrollToBottom(animated: true, forceScroll: true);
      }
    });
  }

  void _sendPollMessage(PollData poll) {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;
    setState(() {
      _isAttachmentMenuOpen = false;
    });
    final chatProvider =
        _chatProvider ?? Provider.of<ChatProvider>(context, listen: false);
    final chatId = widget.chatId ?? 0;
    final replyToMessageId = chatProvider.replyToMessage?.messageId;

    _logger.d(
      "Sending message to ${chatId == 0 ? 'new user' : 'existing chat'}: ${widget.userId}, replyTo: $replyToMessageId",
    );

    chatProvider
        .sendMessage(
          chatId: widget.chatId,
          poll.question, // messageContent = JSON string
          messageType: MessageType.Poll,
          replyToMessageId: replyToMessageId,
          pollOption: poll.options.map((e) => e.text).toList(), // List<String>
          isMultiplePollVotes: poll.allowMultipleVotes, //bool value true/false
        )
        .then((success) {
          if (!_chatProvider!.isDisposedOfChat && mounted) {
            if (success) {
              _sendTypingEvent(false);

              WidgetsBinding.instance.addPostFrameCallback((_) {
                if (!_chatProvider!.isDisposedOfChat && mounted) {
                  _scrollToBottom(animated: true, forceScroll: true);
                }
              });
            } else {
              // Check if there's an API error message to show
              final apiError = chatProvider.apiErrorMessage;
              if (apiError != null && apiError.isNotEmpty) {
                snackbarNew(context, msg: apiError);
                chatProvider.clearApiErrorMessage();
              }
            }
          }
        });
  }

  void _sendVoiceMessage({Duration voiceDuration = Duration.zero}) {
    if (_chatProvider!.isDisposedOfChat || !mounted
    // ||_messageController.text.trim().isEmpty
    ) {
      return;
    }

    // ✅ DEMO MODE: Block media upload for demo accounts
    if (isDemo) {
      snackbarNew(
        context,
        msg: AppString.demoAccountsCannotUploadMedia,
      );
      return;
    }

    final chatProvider =
        _chatProvider ?? Provider.of<ChatProvider>(context, listen: false);
    final chatId = widget.chatId ?? 0;
    final replyToMessageId = chatProvider.replyToMessage?.messageId;

    _logger.d(
      "Sending message to ${chatId == 0 ? 'new user' : 'existing chat'}: ${widget.userId}, replyTo: $replyToMessageId",
    );
    chatProvider.setShareVoice(_selectedVoices!);

    chatProvider
        .sendMessage(
          chatId: chatId,
          "",
          messageType: MessageType.Voice,
          replyToMessageId: replyToMessageId,
          voiceDuration: voiceDuration,
        )
        .then((success) {
          if (!_chatProvider!.isDisposedOfChat && mounted) {
            if (success) {
              _selectedVoices = null;
              _sendTypingEvent(false);

              WidgetsBinding.instance.addPostFrameCallback((_) {
                if (!_chatProvider!.isDisposedOfChat && mounted) {
                  _scrollToBottom(animated: true, forceScroll: true);
                }
              });
            } else {
              // Check if there's an API error message to show
              final apiError = chatProvider.apiErrorMessage;
              if (apiError != null && apiError.isNotEmpty) {
                snackbarNew(context, msg: apiError);
                chatProvider.clearApiErrorMessage();
              }
            }
          }
        });
  }

  void _sendAttachmentMessage(MessageType messageType) {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    final chatProvider =
        _chatProvider ?? Provider.of<ChatProvider>(context, listen: false);
    final chatId = widget.chatId ?? 0;
    final replyToMessageId = chatProvider.replyToMessage?.messageId;

    _logger.d(
      "Sending message to ${chatId == 0 ? 'new user' : 'existing chat'}: ${widget.userId}, replyTo: $replyToMessageId",
    );

    switch (messageType) {
      case MessageType.Image:
      case MessageType.Gif:
        if (_selectedImages != null) {
          chatProvider.setShareImage(_selectedImages!);
        }
        break;
      case MessageType.File:
        if (_selectedDocuments != null) {
          chatProvider.setShareDocument(_selectedDocuments!);
        }
        break;
      case MessageType.Video:
        if (_selectedVideos != null) {
          chatProvider.setShareVideo(_selectedVideos!, _videoThumbnail);
        }
        break;
      default:
        break;
    }

    chatProvider
        .sendMessage(
          chatId: chatId,
          "",
          messageType: messageType,
          replyToMessageId: replyToMessageId,
        )
        .then((success) {
          if (!_chatProvider!.isDisposedOfChat && mounted) {
            if (success) {
              _selectedImages = null;
              _selectedDocuments = null;
              _selectedVideos = null;
              _videoThumbnail = "";

              WidgetsBinding.instance.addPostFrameCallback((_) {
                _scrollToBottom();
              });
            } else {
              // Check if there's an API error message to show
              final apiError = chatProvider.apiErrorMessage;
              if (apiError != null && apiError.isNotEmpty) {
                snackbarNew(context, msg: apiError);
                chatProvider.clearApiErrorMessage();
              }
            }
          }
          closeKeyboard();
        });

    if (mounted) {
      setState(() {
        _isAttachmentMenuOpen = false;
      });
    }
  }

  Future<void> _sendImage({bool isFromGallery = true}) async {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    // ✅ DEMO MODE: Block media upload for demo accounts
    if (isDemo) {
      snackbarNew(
        context,
        msg: AppString.demoAccountsCannotUploadMedia,
      );
      return;
    }

    // Use ImagePicker for gallery to open Photos app on iOS instead of Files app
    final images = await pickImages(
      source: isFromGallery ? ImageSource.gallery : ImageSource.camera,
    );
    if (images == null ||
        images.isEmpty ||
        _chatProvider!.isDisposedOfChat ||
        !mounted) {
      return;
    }

    // An image was picked: close the attachment menu so it isn't left open
    // behind the preview or after the user comes back from it.
    setState(() {
      _isAttachmentMenuOpen = false;
    });

    // Open the preview immediately and compress in the background; the
    // preview shows a loader and keeps send disabled until this completes.
    final picked = images.first;
    final compression = compressOutgoingImage(picked);

    // Let the user review the image; it is only sent after tapping send.
    final confirmed = await ImageSendPreviewScreen.show(
      context,
      picked,
      compression,
    );
    if (!confirmed) {
      // Preview closed without sending: drop the picker/compressor temp copies.
      unawaited(
        compression.then((f) => _discardTempFiles([picked.path, f.path])),
      );
      return;
    }
    final image = await compression;
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    _selectedImages = [image];
    _sendAttachmentMessage(MessageType.Image);
  }

  Future<void> _sendGif() async {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    // ✅ DEMO MODE: Block media upload for demo accounts
    if (isDemo) {
      snackbarNew(
        context,
        msg: AppString.demoAccountsCannotUploadMedia,
      );
      return;
    }

    try {
      _logger.d("Starting GIF picker...");

      // Launch Giphy GIF picker
      final gif = await GiphyGet.getGif(
        context: context,
        apiKey:
            "YOUR_GIPHY_API_KEY", // Demo key - replace with your actual Giphy API key later
        lang: GiphyLanguage.english,
        randomID: "abcd", // Optional: for analytics
        searchText: "Search GIFs", // Placeholder text
        tabColor: AppColors.appPriSecColor.primaryColor,
        debounceTimeInMilliseconds: 350,
      );

      _logger.d(
        "GIF picker result: ${gif != null ? 'GIF selected' : 'No GIF selected'}",
      );

      if (gif != null && !_chatProvider!.isDisposedOfChat && mounted) {
        _logger.d("GIF object: ${gif.toString()}");
        _logger.d("GIF images: ${gif.images?.toString()}");

        // Get the GIF URL - try different formats
        String? gifUrl;

        // Try original first
        if (gif.images?.original != null) {
          gifUrl = gif.images!.original!.url;
        }

        // Fallback to fixed height
        if ((gifUrl == null || gifUrl.isEmpty) &&
            gif.images?.fixedHeight != null) {
          gifUrl = gif.images!.fixedHeight!.url;
        }

        // Fallback to downsized
        if ((gifUrl == null || gifUrl.isEmpty) &&
            gif.images?.downsized != null) {
          gifUrl = gif.images!.downsized!.url;
        }

        // Try different properties if above don't work
        if (gifUrl == null || gifUrl.isEmpty) {
          gifUrl = gif.url ?? gif.bitlyGifUrl ?? gif.bitlyUrl;
        }

        _logger.d("Extracted GIF URL: $gifUrl");

        if (gifUrl != null && gifUrl.isNotEmpty) {
          // Send the GIF URL directly as message content
          final chatProvider =
              _chatProvider ??
              Provider.of<ChatProvider>(context, listen: false);
          final chatId = widget.chatId ?? 0;

          final replyToMessageId = chatProvider.replyToMessage?.messageId;

          _logger.d(
            "Sending GIF message - ChatID: $chatId, URL: $gifUrl, MessageType: ${MessageType.Gif}",
          );

          // For GIF URLs from external sources (like Giphy), we send them directly
          chatProvider
              .sendMessage(
                chatId: chatId,
                gifUrl,
                messageType: MessageType.Gif,
                replyToMessageId: replyToMessageId,
              )
              .then((success) {
                _logger.d("GIF message send result: $success");

                if (!_chatProvider!.isDisposedOfChat && mounted && success) {
                  // Clear reply message if it exists
                  if (chatProvider.replyToMessage != null) {
                    chatProvider.clearReply();
                  }

                  WidgetsBinding.instance.addPostFrameCallback((_) {
                    _scrollToBottom(forceScroll: true);
                  });
                } else {
                  _logger.e("Failed to send GIF message");
                  if (mounted) {
                    ScaffoldMessenger.of(context).showSnackBar(
                      SnackBar(
                        content: Text(AppString.failedToSendGIFPleaseTryAgain),
                        backgroundColor: Colors.red,
                      ),
                    );
                  }
                }
                closeKeyboard();
              });
        } else {
          _logger.e("GIF URL is null or empty");
          if (mounted) {
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(
                content: Text(AppString.couldGIFURLPleaseTryAgain),
                backgroundColor: Colors.orange,
              ),
            );
          }
        }
      } else {
        _logger.d("GIF picker was cancelled or returned null");
      }
    } catch (e) {
      _logger.e("Error picking GIF: $e");
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text(AppString.errorSelectingGIFPleaseTryAgain),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  Future<void> _sendVideo() async {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    // ✅ DEMO MODE: Block media upload for demo accounts
    if (isDemo) {
      snackbarNew(
        context,
        msg: AppString.demoAccountsCannotUploadMedia,
      );
      return;
    }

    // One video at a time: a previous one is still being compressed.
    if (_isPreparingVideo) return;

    // Use ImagePicker for videos to open Photos app on iOS instead of Files app
    final picked = await pickVideo(source: ImageSource.gallery);
    if (picked == null || _chatProvider!.isDisposedOfChat || !mounted) {
      return;
    }

    // A video was picked: close the attachment menu so it isn't left open
    // behind the preview or after the user comes back from it.
    setState(() {
      _isAttachmentMenuOpen = false;
    });

    // Let the user review the original video; it is only sent after
    // tapping send.
    final confirmed = await VideoSendPreviewScreen.show(context, picked);
    if (!confirmed) {
      // Preview closed without sending: drop the picker's temp copy.
      unawaited(_discardTempFiles([picked.path]));
      return;
    }
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    // Back on the chat screen: compress, then send. The input bar's mic
    // button shows a loader for the whole time (compression here, then the
    // upload via ChatProvider.isSendingMessage).
    setState(() => _isPreparingVideo = true);
    final video = await compressOutgoingVideo(picked);

    if (_chatProvider!.isDisposedOfChat || !mounted) {
      // Chat closed during compression: nothing will send these copies.
      _isPreparingVideo = false;
      unawaited(_discardTempFiles([picked.path, video.path]));
      return;
    }
    _selectedVideos = [video];
    // sendMessage flips isSendingMessage on synchronously, so the loader
    // carries straight on from compression into the upload.
    _sendAttachmentMessage(MessageType.Video);
    setState(() => _isPreparingVideo = false);
  }

  Future<void> _sendDocument() async {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    // ✅ DEMO MODE: Block media upload for demo accounts
    if (isDemo) {
      snackbarNew(
        context,
        msg: AppString.demoAccountsCannotUploadMedia,
      );
      return;
    }

    final allowedExtensions = MessageTypeUtils.getAllowedExtensions(
      MessageType.File,
    );

    final PlatformFile? pickedFile = await FilePicker.pickFile(
      type: FileType.custom,
      allowedExtensions: allowedExtensions,
    );

    final path = pickedFile?.path;
    if (path == null || _chatProvider!.isDisposedOfChat || !mounted) return;
    final document = File(path);

    // A document was picked: close the attachment menu so it isn't left open
    // behind the preview or after the user comes back from it.
    setState(() {
      _isAttachmentMenuOpen = false;
    });

    // Let the user review the document; it is only sent after tapping send.
    final confirmed = await DocumentSendPreviewScreen.show(context, document);
    if (!confirmed) {
      // Preview closed without sending: drop the picker's temp copy.
      unawaited(_discardTempFiles([document.path]));
      return;
    }
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    _selectedDocuments = [document];
    _sendAttachmentMessage(MessageType.File);
  }

  void _sendLocation() async {
    if (_chatProvider!.isDisposedOfChat || !mounted || _isSendingLocation) {
      return;
    }

    final chatProvider =
        _chatProvider ?? Provider.of<ChatProvider>(context, listen: false);
    final chatId = widget.chatId ?? 0;
    final replyToMessageId = chatProvider.replyToMessage?.messageId;

    _logger.d(
      "Sending message to ${chatId == 0 ? 'new user' : 'existing chat'}: ${widget.userId}, replyTo: $replyToMessageId",
    );

    // Show loading state but keep dialog open
    if (mounted) {
      setState(() {
        _isSendingLocation = true;
      });
    }

    try {
      // Get user's current location (checkLocationPermission fetches it once
      // permission is granted)
      final locationService = LocationService();
      await locationService.checkLocationPermission();

      if (!mounted) return;
      if (locationService.latitude == 0 && locationService.longitude == 0) {
        setState(() {
          _isSendingLocation = false;
        });
        snackbarNew(
          context,
          msg: AppString.unableToGetYourCurrentLocation,
        );
        return;
      }

      // Location is ready — stop the loader and close the attachment menu so
      // it isn't still open when the user comes back from the location screen
      setState(() {
        _isSendingLocation = false;
        _isAttachmentMenuOpen = false;
      });

      final result = await Navigator.push<Map<String, dynamic>>(
        context,
        MaterialPageRoute(
          builder:
              (context) => LocationScreen(
                userLocation:
                    locationService.locationAddress ??
                    "${locationService.latitude}, ${locationService.longitude}",
                latitude: locationService.latitude,
                longitude: locationService.longitude,
              ),
        ),
      );
      if (!mounted) return;
      FocusScope.of(context).unfocus();
      if (result != null) {
        // Receivers parse location messages as "lat,lng"
        final locationData = "${result['latitude']},${result['longitude']}";
        log("Navigator_POP:$locationData");
        chatProvider
            .sendMessage(
              chatId: chatId,
              locationData,
              messageType: MessageType.Location,
              replyToMessageId: replyToMessageId,
            )
            .then((success) {
              if (success && !_chatProvider!.isDisposedOfChat && mounted) {
                WidgetsBinding.instance.addPostFrameCallback((_) {
                  _scrollToBottom(forceScroll: true);
                });
              }
              closeKeyboard();
            });
      } else {
        closeKeyboard();
      }
    } catch (e) {
      closeKeyboard();
      debugPrint("Error getting location: $e");
      if (!_chatProvider!.isDisposedOfChat && mounted) {
        setState(() {
          _isSendingLocation = false;
        });
        snackbarNew(context, msg: AppString.unableToSendLocation);
      }
    }
  }

  void _sendContact() async {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    setState(() {
      _isAttachmentMenuOpen = false;
    });

    try {
      // Show contact picker dialog
      final selectedContact = await _showContactPicker();

      if (selectedContact != null) {
        if (!mounted) return;
        final chatProvider =
            _chatProvider ?? Provider.of<ChatProvider>(context, listen: false);
        final chatId = widget.chatId ?? 0;
        final replyToMessageId = chatProvider.replyToMessage?.messageId;

        _logger.d(
          "Sending message to ${chatId == 0 ? 'new user' : 'existing chat'}: ${widget.userId}, replyTo: $replyToMessageId",
        );

        // Send contact message with both name and phone number
        // Format: "Name,PhoneNumber" so we can split it later
        final messageContent =
            '${selectedContact.name},${selectedContact.phoneNumber}';

        chatProvider
            .sendMessage(
              chatId: chatId,
              messageContent,
              messageType: MessageType.Contact,
              replyToMessageId: replyToMessageId,
            )
            .then((success) {
              if (success && mounted) {
                WidgetsBinding.instance.addPostFrameCallback((_) {
                  _scrollToBottom(forceScroll: true);
                });
              }
              closeKeyboard();
            });
      }
    } catch (e) {
      debugPrint('Error sending contact: $e');
    }
  }

  Future<ContactModel?> _showContactPicker() async {
    return showModalBottomSheet<ContactModel>(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.transparent,
      builder: (BuildContext context) {
        return ContactPickerBottomSheet();
      },
    );
  }

  Future<List<File>?> pickImages({required ImageSource source}) async {
    if (_chatProvider!.isDisposedOfChat || !mounted) return null;

    try {
      // No picker-side imageQuality: that re-encodes before returning and
      // delays the preview. Compression runs while the preview is open.
      final XFile? pickedImage = await ImagePicker().pickImage(source: source);

      if (pickedImage != null && !_chatProvider!.isDisposedOfChat && mounted) {
        return [File(pickedImage.path)];
      }
      return null;
    } catch (e) {
      _logger.e('Error picking image: $e');
      return null;
    }
  }

  /// Deletes temp copies of a picked file (video, document) that won't be
  /// sent. Only files inside the app's temp/cache directory (where the
  /// pickers and compressor write) are touched, so a user's original file is
  /// never deleted.
  Future<void> _discardTempFiles(List<String> paths) async {
    try {
      final tempDir = await getTemporaryDirectory();
      final tempRoots = {tempDir.path, await tempDir.resolveSymbolicLinks()};
      for (final path in paths.toSet()) {
        final file = File(path);
        if (!await file.exists()) continue;
        final resolved = await file.resolveSymbolicLinks();
        final isTemp = tempRoots.any(
          (root) => path.startsWith(root) || resolved.startsWith(root),
        );
        if (!isTemp) continue;
        await file.delete();
        _logger.d('Discarded unsent file: $path');
      }
    } catch (e) {
      _logger.w('Failed to discard unsent files: $e');
    }
  }

  /// Picks a video. Compression is left to the caller so the send preview
  /// can open without waiting for it.
  Future<File?> pickVideo({required ImageSource source}) async {
    if (_chatProvider!.isDisposedOfChat || !mounted) return null;

    try {
      final XFile? pickedVideo = await ImagePicker().pickVideo(source: source);

      if (pickedVideo != null && !_chatProvider!.isDisposedOfChat && mounted) {
        return File(pickedVideo.path);
      }
      return null;
    } catch (e) {
      _logger.e('Error picking video: $e');
      return null;
    }
  }

