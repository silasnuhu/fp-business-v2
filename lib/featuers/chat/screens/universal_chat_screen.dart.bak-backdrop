  void _sendTypingEvent(bool isTyping) {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    final chatProvider =
        _chatProvider ?? Provider.of<ChatProvider>(context, listen: false);

    final currentChatId = chatProvider.currentChatData.chatId ?? 0;

    _logger.d(
      "Sending typing event - ChatId: $currentChatId, UserId: ${widget.userId}, IsTyping: $isTyping",
    );

    chatProvider.sendTypingStatus(currentChatId, isTyping);
  }

  // ═══════════════════════════════════════════════════════════════════════════
  // ONLINE STATUS & USER DATA METHODS
  // ═══════════════════════════════════════════════════════════════════════════

  /// Online state for the header.
  ///
  /// The socket presence cache merged with the peer's `isOnline` from
  /// `users/batch` (read on chat open, and kept in step by every later
  /// `presence_update`), so it covers the case the socket cache alone
  /// can't: a peer who was already online before this session connected and
  /// hasn't changed state since.
  ///
  /// The merge lives in ChatProvider.displayableIsOnlineFor so it is gated
  /// on the peer's `lastSeenVisible` flag — the header shows "Online"
  /// instead of a last seen, so an ungated merge here leaked the presence
  /// that suppressing the timestamp was meant to hide.
  bool _isUserOnlineFromChatListOrApi(ChatProvider chatProvider) {
    return chatProvider.displayableIsOnlineFor(widget.userId ?? 0);
  }

  /// Last-seen timestamp for the header.
  ///
  /// Two real sources, merged newest-wins: the peer's `lastSeenAt` from
  /// `users/batch` (fetched on chat open) and the local stamp of any
  /// `presence_update` received since — the socket payload has no timestamp
  /// of its own, but the moment it reports the peer going offline IS a
  /// last-seen.
  ///
  /// The merge lives in ChatProvider.displayableLastSeenFor because the
  /// socket stamp has to be gated on the peer's `lastSeenVisible` flag, and
  /// doing that merge here instead re-introduced the socket value on every
  /// rebuild — so a peer who hides last seen, or who has blocked us, still
  /// showed a timestamp even though `users/batch` returned `lastSeenAt:null`.
  ///
  /// The chat-list peer row is deliberately not a fallback here: its
  /// `updatedAt`/`createdAt` are profile/conversation timestamps, not
  /// presence, so rendering them as "last seen" told users the peer was
  /// last seen on a date they never were. No timestamp now means no
  /// timestamp shown.
  String? _getLastSeenTimeFromChatListOrApi(ChatProvider chatProvider) {
    return chatProvider.displayableLastSeenFor(widget.userId ?? 0);
  }

