                                Text(
                                  "$selectedMessagesCount ${AppString.homeScreenString.messages}",
                                  style: AppTypography.innerText14(
                                    context,
                                  ).copyWith(
                                    fontSize: 12.5,
                                    fontWeight: FontWeight.w600,
                                  ),
                                ),
                              ],
                            ),
                          )
                          : Container(
                            color: AppThemeManage.appTheme.darkGreyColor,
                            padding: EdgeInsets.only(
                              bottom:
                                  Platform.isIOS
                                      ? MediaQuery.of(context).padding.bottom
                                      : 0,
                            ),
                            child: Column(
                              mainAxisSize: MainAxisSize.min,
                              children: [
                                if (replyMessage != null)
                                  _buildReplyPreview(
                                    replyMessage,
                                    chatProvider,
                                  ),

                                (widget.isGroupChat &&
                                        groupProvider.isMembersLoading)
                                    ? SizedBox.shrink()
                                    : (widget.isGroupChat &&
                                        !groupProvider.isMember(userID))
                                    ? SizedBox.shrink()
                                    : ChatKeyboard(
                                      controller: _messageController,
                                      focusNode: _messageFocusNode,
                                      onTap: () {
                                        setState(() {
                                          _isAttachmentMenuOpen = false;
                                        });
                                      },
                                      onTapSendMsg: () {
                                        if (!_chatProvider!.isDisposedOfChat &&
                                            mounted &&
                                            !isLoading &&
                                            _messageController.text
                                                .trim()
                                                .isNotEmpty) {
                                          _sendTextMessage();
                                        }
                                      },
                                      //*___________________________________ Hold Record __________________________________________________
                                      onPointerDown: onPointerDown,
                                      //*___________________________________ Record End __________________________________________________
                                      onPointerUp: onPointerUp,
                                      //*_____________________________________________________________________________________
                                      onTapPin: () {
                                        if (!_chatProvider!.isDisposedOfChat &&
                                            mounted) {
                                          setState(() {
                                            _isAttachmentMenuOpen =
                                                !_isAttachmentMenuOpen;
                                          });
                                          closeKeyboard();
                                        }
                                      },
                                      onTapCamera:
                                          () =>
                                              _sendImage(isFromGallery: false),
                                      onChanged: (text) {
                                        debugPrint(
                                          "Mounted is $mounted and isDisposedOfChats is  ${_chatProvider!.isDisposedOfChat}",
                                        );
                                        if (!mounted ||
                                            _chatProvider!.isDisposedOfChat) {
                                          return;
                                        }

                                        if (isURL(text.trim())) {
                                          debugPrint("✅ URL detected: $text");
                                        }

                                        if (text.isNotEmpty && !_isTyping) {
                                          _isTyping = true;
                                          _sendTypingEvent(true);
                                        } else if (text.isEmpty && _isTyping) {
                                          _isTyping = false;
                                          _sendTypingEvent(false);
                                        }

                                        _typingTimer?.cancel();
                                        _typingTimer = Timer(
                                          Duration(seconds: 2),
                                          () {
                                            if (!_chatProvider!
                                                    .isDisposedOfChat &&
                                                mounted &&
                                                _isTyping) {
                                              _isTyping = false;
                                              _sendTypingEvent(false);
                                            }
                                          },
                                        );
                                      },
                                      isLoading: isLoading,
                                      // AI Assistant: text messages only.
                                      textOnly: _isAiAssistantChat,
                                    ),
                              ],
                            ),
                          );
                    },
                  );
                },
              ),
    );
  }

  // =================== VARIABLES ===================

  bool recordingStarted = false;
  bool isRecording = false;
  bool record = false;

  bool _recorderBusy = false;
  bool _sheetInitialized = false;

  DateTime? _recordStartTime;
  static const int _minHoldMs = 500;

  Duration _recordDuration = Duration.zero;
  Timer? newtimer;
  bool _isPointerDown = false;

  // =================== POINTER EVENTS ===================

  void onPointerDown(PointerDownEvent event) {
    // No voice recording while the mic button shows its loader (a message,
    // e.g. a video, is still being prepared or sent).
    if (_isPreparingVideo || (_chatProvider?.isSendingMessage ?? false)) {
      return;
    }
    setState(() {
      _isPointerDown = true;
    });
    voiceBottomSheet();
  }

  Future<void> onPointerUp(PointerUpEvent event) async {
    setState(() {
      _isPointerDown = false;
    });

    if (!recordingStarted) return;

    final now = DateTime.now();

    if (_recordStartTime == null ||
        now.difference(_recordStartTime!).inMilliseconds < _minHoldMs) {
      await stopRecord(isCancel: true);
      Navigator.pop(context);
      snackbarNew(context, msg: AppString.holdToRecord);
      return;
    }

    final recording = await stopRecord();
    if (!mounted) return;
    Navigator.pop(context);
    if (recording == null) return;

    // Let the user listen to the recording and decide: send or delete.
    final send = await showVoiceRecordPreview(
      context,
      file: recording.file,
      recordedDuration: recording.duration,
    );
    if (send && mounted && !_chatProvider!.isDisposedOfChat) {
      _selectedVoices = recording.file;
      _sendVoiceMessage(voiceDuration: recording.duration);
      return;
    }
    // Deleted (or the chat went away): remove the recorded temp file.
    unawaited(
      recording.file.delete().then(
        (_) {},
        onError: (Object e) {
          debugPrint("Delete recording error: $e");
        },
      ),
    );
  }

  // =================== PERMISSION ===================

  Future<bool> checkPermission() async {
    if (await Permission.microphone.isGranted) return true;
    final status = await Permission.microphone.request();
    return status == PermissionStatus.granted;
  }

  // =================== START RECORD ===================

  Future<void> startRecord(VoidCallback updateSheet) async {
    if (_recorderBusy || recordingStarted) return;
    _recorderBusy = true;

    try {
      if (!await audioRecord.hasPermission()) return;

      final dir = await getTemporaryDirectory();
      final path =
          '${dir.path}/recording_${DateTime.now().millisecondsSinceEpoch}.m4a';

      await audioRecord.start(
        RecordConfig(
          encoder: AudioEncoder.aacLc,
          bitRate: 128000,
          sampleRate: 44100,
        ),
        path: path,
      );

      _recordStartTime = DateTime.now();

      setState(() {
        recordingStarted = true;
        isRecording = true;
        _recordDuration = Duration.zero;
      });

      newtimer?.cancel();
      newtimer = Timer.periodic(const Duration(seconds: 1), (_) {
        _recordDuration += const Duration(seconds: 1);
        updateSheet();
      });
    } catch (e) {
      debugPrint("Start record error: $e");
    } finally {
      _recorderBusy = false;
    }
  }

  // =================== STOP RECORD ===================

  /// Stops recording. Returns the finished recording (to be previewed before
  /// sending), or null when cancelled, empty or it failed.
  Future<({File file, Duration duration})?> stopRecord({
    bool isCancel = false,
  }) async {
    if (_recorderBusy || !recordingStarted) return null;
    _recorderBusy = true;

    try {
      newtimer?.cancel();
      newtimer = null;

      // ✅ duration ko pehle store karo
      final recordedDuration = _recordDuration;

      String? path;
      try {
        path = await audioRecord.stop().timeout(const Duration(seconds: 3));
      } catch (_) {
        debugPrint("Recorder stop timeout");
      }

      setState(() {
        recordingStarted = false;
        isRecording = false;
        record = false;
        _recordStartTime = null;
        _recordDuration = Duration.zero;
      });

      if (path != null && !isCancel && recordedDuration.inSeconds > 0) {
        logger.v("recordedDuration: $recordedDuration");
        return (file: File(path), duration: recordedDuration);
      }
    } catch (e) {
      debugPrint("Stop record error: $e");
    } finally {
      _recorderBusy = false;
    }
    return null;
  }

  // =================== FORMAT TIME ===================

  String formatTime(Duration d) {
    final m = d.inMinutes.toString().padLeft(2, '0');
    final s = (d.inSeconds % 60).toString().padLeft(2, '0');
    return "$m:$s";
  }

  // =================== BOTTOM SHEET ===================

  Future voiceBottomSheet() {
    _sheetInitialized = false;

    return bottomSheetGobalWithoutTitle(
      context,
      barrierDismissible: false,
      isCrossIconHide: true,
      bottomsheetHeight: 200,
      child: StatefulBuilder(
        builder: (context, setSheetState) {
          WidgetsBinding.instance.addPostFrameCallback((_) async {
            if (_sheetInitialized) return;
            _sheetInitialized = true;

            bool granted = await checkPermission();
            if (!granted) {
              snackbarNew(
                context,
                msg: AppString.microphonePermissionRequired,
              );
              Navigator.pop(context);
              return;
            }

            if (!_isPointerDown) {
              Navigator.pop(context);
              return;
            }

            await HapticFeedback.lightImpact();

            setSheetState(() {
              record = true;
            });

            await startRecord(() {
              if (mounted) setSheetState(() {});
            });
          });

          return Padding(
            padding: EdgeInsets.symmetric(vertical: 16),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Flexible(
                  child: Stack(
                    alignment: Alignment.center,
                    children: [
                      MicWaveAnimation(
                        size: 60,
                        color: AppColors.appPriSecColor.primaryColor,
                      ),
                      Container(
                        height: 60,
                        width: 60,
                        decoration: BoxDecoration(
                          shape: BoxShape.circle,
                          color: AppColors.appPriSecColor.primaryColor
                              .withValues(alpha: 0.5),
                        ),
                        child: Center(
                          child: SvgPicture.asset(
                            AppAssets.chatMsgTypeIcon.voiceMic,
                            colorFilter: ColorFilter.mode(
                              AppColors.appPriSecColor.primaryColor,
                              BlendMode.srcIn,
                            ),
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
                SizedBox(height: 12),
                Text(
                  isRecording ? formatTime(_recordDuration) : "00:00",
                  style: AppTypography.h418(context),
                ),
                SizedBox(height: 12),
                GestureDetector(
                  onTap: () async {
                    final navigator = Navigator.of(context);
                    await stopRecord(isCancel: true);
                    if (mounted) navigator.pop();
                  },
                  child: Container(
                    padding: EdgeInsets.symmetric(horizontal: 24, vertical: 10),
                    decoration: BoxDecoration(
                      color: Colors.red.withValues(alpha: 0.1),
                      borderRadius: BorderRadius.circular(20),
                      border: Border.all(
                        color: Colors.red.withValues(alpha: 0.3),
                        width: 1,
                      ),
                    ),
                    child: Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Icon(Icons.close, color: Colors.red, size: 18),
                        SizedBox(width: 4),
                        Text(
                          "Cancel",
                          style: AppTypography.captionText(context).copyWith(
                            color: Colors.red,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              ],
            ),
          );
        },
      ),
    );
  }

