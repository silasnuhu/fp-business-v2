  @override
  void didUpdateWidget(UniversalChatScreen oldWidget) {
    super.didUpdateWidget(oldWidget);

    if (oldWidget.chatId != widget.chatId ||
        oldWidget.userId != widget.userId) {
      _logger.d("Chat changed, updating focus");
      _chatProvider!.setScreenActive(true, widget.chatId, widget.userId);
      // Block status is now handled via Provider Consumer pattern
    }

    if (!_chatProvider!.isDisposedOfChat &&
        oldWidget.chatId != widget.chatId &&
        widget.chatId != null &&
        widget.chatId! > 0) {
      _logger.d("Chat ID changed, reinitializing chat");
      _chatProvider!.setIsInitialized(false);
      // Reset cached data flag for new chat
      _chatProvider!.setHasCachedData(false);
      // 🚀 PERFORMANCE: Check cache for new chat to prevent loading flicker
      _checkCacheAvailability();
      _initializeChat();
    }
  }

  /// A full-screen route above this chat just closed. If that was another
  /// chat (e.g. one opened from a notification tap), it re-pointed the shared
  /// ChatProvider at its own chat — take it back and reload this chat, the
  /// same way the first open in initState does (cache first, then server).
  @override
  void didPopNext() {
    // Deferred a frame: popUntil() also calls this on screens it is about to
    // pop in the same pass, and those must not reload anything.
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!mounted || _chatProvider == null) return;
      if (ModalRoute.of(context)?.isCurrent != true) return;
      if (_chatProvider!.isChatScreenOwner(this)) return;
      _reactivateChat();
    });
  }

  void _reactivateChat() {
    _logger.d("♻️ Back on chat ${widget.chatId} - reloading its data");

    _chatProvider!.claimChatScreen(this);
    _chatProvider!.resetAll();
    _chatProvider!.initOfUniversal(
      context: context,
      chatId: widget.chatId,
      userId: widget.userId,
      isGroupChat: widget.isGroupChat,
    );

    if (widget.isGroupChat) {
      Provider.of<GroupProvider>(context, listen: false).setGroupInfo(
        groupName: widget.chatName,
        groupDescription: null,
        groupIcon: widget.profilePic,
      );
      _loadGroupMembers();
    }

    setState(() {
      _showNewMessageIndicator = false;
      _newMessageCount = 0;
      _preventAutoScroll = false;
    });
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    super.didChangeAppLifecycleState(state);
    _logger.d('App lifecycle state changed: $state');

    if (_chatProvider != null) {
      switch (state) {
        case AppLifecycleState.resumed:
          _chatProvider!.setAppForegroundState(true);
          Future.delayed(Duration(milliseconds: 500), () {
            // A chat covered by another chat must not mark itself active —
            // that would mark its messages seen while the user reads the
            // other one.
            if (_chatProvider!.isScreenActive &&
                !_chatProvider!.isDisposedOfChat &&
                _chatProvider!.isChatScreenOwner(this) &&
                mounted) {
              _chatProvider!.setScreenActive(
                true,
                widget.chatId,
                widget.userId,
              );
            }
          });
          break;
        case AppLifecycleState.paused:
        case AppLifecycleState.inactive:
        case AppLifecycleState.detached:
        case AppLifecycleState.hidden:
          _chatProvider!.setAppForegroundState(false);
          break;
      }
    }
  }

  @override
  void dispose() {
    _logger.d("UniversalChatScreen dispose called");
    audioRecord.dispose();
    audioPlayer.dispose();
    // Cancel timers/subscriptions early
    _typingTimer?.cancel();
    _scrollDebounceTimer?.cancel();
    _paginationDebounceTimer?.cancel();
    _newMessageSubscription?.cancel();

    // Dispose controllers/focus nodes
    _messageController.dispose();

    _scrollController.removeListener(_onScroll);
    _scrollController.dispose();
    _searchController.dispose();
    _searchFocusNode.dispose();

    // Provider updates last — only if the provider still holds THIS chat.
    // When this chat was closed back onto another chat screen, that screen
    // has already reclaimed the provider (didPopNext); resetting here would
    // wipe the chat now on screen.
    if (_chatProvider != null && _chatProvider!.isChatScreenOwner(this)) {
      try {
        _chatProvider!.setChatScreenActive(
          widget.chatId ?? 0,
          widget.userId ?? 0,
          isActive: false,
        );
        _chatProvider!.setIsDisposedOfChat(true);
        _chatProvider!.setCurrentChat(0, 0);
      } catch (e) {
        _logger.e("Error resetting chat in dispose: $e");
      }
      _chatProvider!.releaseChatScreen(this);
    }

    NavigationHelper.pageRouteObserver.unsubscribe(this);
    WidgetsBinding.instance.removeObserver(this);
    _messageFocusNode.dispose();

    super.dispose();
  }

