  /// Only the sender can edit, only the text body can change, and a message
  /// deleted for everyone (or not yet confirmed by the server) can't be.
  bool _canEditMessage(chats.Records message) {
    final type = message.messageType?.toLowerCase();
    return message.messageId != null &&
        !message.isOptimistic &&
        !message.isFailed &&
        message.deletedForEveryone != true &&
        (type == 'text' || type == 'link') &&
        message.senderId?.toString() == _chatProvider?.currentUserId;
  }

  Future<void> _handleEditMessage(chats.Records message) async {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;
    final messageId = message.messageId;
    if (messageId == null) return;

    final newText = await showEditMessageSheet(
      context,
      initialText: message.messageContent ?? '',
    );
    if (newText == null || !mounted) return;

    final chatProvider =
        _chatProvider ?? Provider.of<ChatProvider>(context, listen: false);
    final success = await chatProvider.editMessage(
      messageId: messageId,
      newBody: newText,
    );

    if (!success && mounted) {
      final reason = chatProvider.editMessageError;
      snackbarNew(
        context,
        msg:
            reason != null && reason.isNotEmpty
                ? reason
                : AppString.failedToEditMessage,
      );
    }
  }

  void _handleReply(chats.Records message) {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    final chatProvider =
        _chatProvider ?? Provider.of<ChatProvider>(context, listen: false);

    chatProvider.setReplyToMessage(message);
    _messageFocusNode.requestFocus();

    _logger.d('Reply set for message: ${message.messageId}');
  }

  void _handleImageTap(String imageUrl) {
    if (_chatProvider!.isDisposedOfChat || !mounted) return;

    context.viewImage(
      imageSource: imageUrl,
      imageTitle: 'Chat Image',
      heroTag: imageUrl,
