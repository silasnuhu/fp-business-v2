+// --- whoxa patch: guard against EXC_BAD_ACCESS in postEvent -------------------
+// WebRTC delegate callbacks arrive on background threads and are hopped to the
+// main thread here. If the FlutterEngine / binary messenger is torn down in the
+// meantime (logout, call teardown, app termination) the captured FlutterEventSink
+// points at freed memory and invoking it segfaults. Track engine attachment and
+// re-check it (plus a nil check) on the main thread before firing.
+static volatile BOOL _whoxaFlutterWebRTCPluginAttached = NO;
+
+static BOOL whoxaFlutterWebRTCPluginIsAttached(void) {
+  return _whoxaFlutterWebRTCPluginAttached;
+}
+
+void postEvent(FlutterEventSink _Nullable sink, id _Nullable event) {
+  if (sink == nil) {
+    return;
+  }
+  FlutterEventSink strongSink = sink;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    if (!whoxaFlutterWebRTCPluginIsAttached() || strongSink == nil) {
+      return;
+    }
+    strongSink(event);
+  });
+}
+// --- end whoxa patch --------------------------------------------------------

@@ - (instancetype)initWithChannel:... @@
   self = [super init];
